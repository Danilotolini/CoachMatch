              "console.log(\"=== RESPOSTA COMPLETA ===\");",
              "console.log(JSON.stringify(json, null, 2));",
              "",
              "console.log(\"=== ESTRUTURA ===\");",
              "console.log(\"Tem 'upload'?\", !!json.upload);",
              "console.log(\"Tem 'upload.url'?\", !!(json.upload && json.upload.url));",
              "console.log(\"Tem 'upload.fields'?\", !!(json.upload && json.upload.fields));",
              "console.log(\"Tem 'key'?\", !!json.key);",
              "",
              "if (!json.upload || !json.upload.url || !json.upload.fields) {",
              "  console.error(\"ERRO: Estrutura inesperada na resposta\");",
              "  throw new Error(\"Resposta não tem 'upload.url' ou 'upload.fields'\");",
              "}",
              "",
              "pm.globals.set(\"uploadUrl\", json.upload.url);",
              "pm.globals.set(\"uploadKey\", json.key);",
              "",
              "console.log(\"=== SALVANDO FIELDS EM GLOBALS ===\");",
              "Object.entries(json.upload.fields).forEach(([k, v]) => {",
              "  const varName = `upload_${k}`;",
              "  pm.globals.set(varName, v);",
              "  console.log(`  ${varName} = ${v.substring(0, 40)}${v.length > 40 ? \"...\" : \"\"}`);",
              "});",
              "",
              "console.log(\"=== CONCLUÍDO ===\");",
              "console.log(\"Total de globals salvas:\", Object.keys(json.upload.fields).length + 2);"
