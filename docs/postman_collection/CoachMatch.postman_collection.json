    {
      "name": "1 - Obter o IdToken do Cognito",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const CryptoJS = require(\"crypto-js\");",
              "",
              "const username = \"joao@exemplo.com\";",
              "const clientId = \"76hul7797npfkmpoju0mbghti7\";",
              "const clientSecret = \"8jn87ckmp7cdime8ah1b0iqe501md0ivv9m9ndrtofs4kol9s3t\";",
              "",
              "const message = username + clientId;",
              "const hash = CryptoJS.HmacSHA256(message, clientSecret);",
              "const secretHash = CryptoJS.enc.Base64.stringify(hash);",
              "",
              "pm.environment.set(\"secretHash\", secretHash);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "",
              "if (json.AuthenticationResult && json.AuthenticationResult.IdToken) {",
              "  const token = json.AuthenticationResult.IdToken;",
              "",
              "  // Tenta salvar no environment ativo; se não houver, usa globals",
              "  if (pm.environment.name) {",
              "    pm.environment.set(\"idToken\", token);",
              "    console.log(`IdToken salvo no environment: ${pm.environment.name}`);",
              "  } else {",
              "    pm.globals.set(\"idToken\", token);",
              "    console.log(\"Nenhum environment ativo — IdToken salvo em globals\");",
              "  }",
              "} else {",
              "  console.log(\"Resposta inesperada:\", json);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-amz-json-1.1",
            "type": "text"
          },
          {
            "key": "X-Amz-Target",
            "value": "AWSCognitoIdentityProviderService.InitiateAuth",
            "type": "text"
          },
          {
            "key": "",
            "value": "",
            "type": "text",
            "disabled": true
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"76hul7797npfkmpoju0mbghti7\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"joao@exemplo.com\",\n    \"PASSWORD\": \"SenhaForte123!\",\n    \"SECRET_HASH\": \"{{secretHash}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
