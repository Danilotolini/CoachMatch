{
  "id": null,
  "uid": "coachmatch-overview",
  "title": "CoachMatch",
  "tags": ["coachmatch"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "hide": 0,
        "current": {}
      },
      {
        "name": "stage",
        "type": "custom",
        "label": "Stage",
        "hide": 0,
        "options": [
          { "text": "dev",  "value": "dev",  "selected": true },
          { "text": "prod", "value": "prod", "selected": false }
        ],
        "current": { "text": "dev", "value": "dev" },
        "query": "dev,prod"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Visão Geral",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requisições",
      "description": "Total de requisições concluídas no período",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" [$__range]))",
          "legendFormat": "requisições",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erros",
      "description": "Requisições com status >= 400 no período",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | statusCode >= 400 [$__range]))",
          "legendFormat": "erros",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latência P95 (ms)",
      "description": "Percentil 95 do tempo de resposta",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 3000 }
            ]
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.95, {service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | unwrap duration_ms [5m]) by ()",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cold Starts",
      "description": "Inicializações da Lambda no período",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({service_name=\"coachmatch-$stage\"} |~ \"INIT_START\" [$__range]))",
          "legendFormat": "cold starts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Tráfego",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requisições por minuto",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(rate({service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" [$__interval]))",
          "legendFormat": "todas",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(rate({service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | statusCode >= 400 [$__interval]))",
          "legendFormat": "erros",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latência (ms)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.50, {service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | unwrap duration_ms [1m]) by ()",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.95, {service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | unwrap duration_ms [1m]) by ()",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.99, {service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | unwrap duration_ms [1m]) by ()",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Endpoints",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "table",
      "title": "Requisições por endpoint",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": { "sortBy": [{ "displayName": "Value #A", "desc": true }] },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum by (path) (count_over_time({service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" [$__range]))",
          "legendFormat": "{{path}}",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Erros por endpoint",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": { "sortBy": [{ "displayName": "Value #A", "desc": true }] },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "red", "mode": "fixed" } }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum by (path) (count_over_time({service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | statusCode >= 400 [$__range]))",
          "legendFormat": "{{path}}",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Logs de Erro",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "{service_name=\"coachmatch-$stage\"} | json | message=\"request_end\" | statusCode >= 400",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Todos os logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "{service_name=\"coachmatch-$stage\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
