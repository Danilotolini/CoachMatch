# Modelo de variáveis de ambiente — copie para `.env` (não versionado).
#
# Perfil AWS usado nos deploys manuais (login via SSO: `aws sso login --profile <perfil>`).
# O Serverless v4 carrega este .env automaticamente.
AWS_PROFILE=JoaoAdm
# Chaves do app do Stream de dev, para o chat no stage local (pnpm dev). Os valores
# estão no Parameter Store: /coachmatch/dev/stream-api-key e /coachmatch/dev/stream-api-secret.
STREAM_API_KEY=
STREAM_API_SECRET=
