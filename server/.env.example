# Backend CoachMatch — variáveis de ambiente (copie para `.env` e preencha)
# NUNCA commitar o `.env` real — ele contém segredos.

# --- Stream Chat (backend) ---
# Obtidas em https://dashboard.getstream.io. O apiSecret fica APENAS aqui.
STREAM_API_KEY=
STREAM_API_SECRET=

# --- DynamoDB / ambiente local (serverless offline) ---
STAGE=local
REGION=us-east-1
ENDPOINT=http://localhost:8000
ACCESS_KEY_ID=fakeMyKeyId
SECRET_ACCESS_KEY=fakeSecretAccessKey
